# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN_2=your_telegram_bot_token_here

# Hugging Face Access Token (free — from https://huggingface.co/settings/tokens)
HUGGING_FACE_ACCESS_TOKEN=your_hf_token_here
HF_TOKEN=your_hf_token_here

# Webhook mode (recommended — instant responses)
# Set this to your Railway public domain after generating it in Settings > Networking
# Leave EMPTY to fall back to polling mode
WEBHOOK_URL=https://your-app.up.railway.app

# Optional: webhook security secret (auto-defaults if not set)
WEBHOOK_SECRET=komara_secret_2026

# Port (Railway sets this automatically — do not set manually)
# PORT=8080
